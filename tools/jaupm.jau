import "pkg.jau"

/*
    Jau Package Manager 0.7

    Protected source packages remain the default JAUPKG2 format. Native packages
    may additionally carry a platform runtime selected by runtime_<platform>_<arch>
    in jau.pkg. The selected DLL/SO is staged beside the opaque installed archive
    so Jau VM code can load it through the standard ffi.jau module.
*/

func usage() {
    print("JauPM 0.7");
    print("  jaupm help");
    print("  jaupm version");
    print("  jaupm init NAME");
    print("  jaupm pack [OUTPUT.jaup]");
    print("  jaupm install NAME|FILE.jaup|URL [URL]");
    print("  jaupm install-manifest URL");
    print("  jaupm verify FILE.jaup");
    print("  jaupm info NAME|FILE.jaup");
    print("  jaupm unpack FILE.jaup DIR");
    print("  jaupm update NAME");
    print("  jaupm remove NAME");
    print("  jaupm list");
    print("  jaupm where NAME");
    print("  jaupm runtime NAME");
    print("  jaupm registry");
    print("  jaupm config get registry");
    print("  jaupm config set registry URL");
    print("  jaupm cache-clean");
    print("  jaupm home");
    print("  jaupm doctor");
    return 0;
}

func ensure_root() {
    let h = package_home();
    mkdir(h);
    mkdir(path_join(h, "packages"));
    mkdir(path_join(h, "cache"));
    return h;
}

func config_path() { return path_join(package_home(), "jaupm.conf"); }
func default_registry() { return "https://irautox.ir/package"; }

func strip_trailing_slash(value) {
    let out = trim(value);
    while (len(out) > 0 && char_at(out, len(out) - 1) == "/") {
        out = substr(out, 0, len(out) - 1);
    }
    return out;
}

func registry_base() {
    let env = getenv("JAU_REGISTRY");
    if (env != "") { return strip_trailing_slash(env); }
    let cfg = config_path();
    if (file_exists(cfg)) {
        let value = manifest_value(read_file(cfg), "registry");
        if (value != "") { return strip_trailing_slash(value); }
    }
    return default_registry();
}

func registry_url(name) { return registry_base() + "/" + name; }

func config_set_registry(url) {
    ensure_root();
    let value = strip_trailing_slash(url);
    if (value == "") { print("JauPM: registry URL cannot be empty"); return 1; }
    write_file(config_path(), "registry=\"" + value + "\"\n");
    print("Registry: " + value);
    return 0;
}

func show_manifest(text) {
    print("name: " + manifest_value(text, "name"));
    print("version: " + manifest_value(text, "version"));
    print("main: " + manifest_value(text, "main"));
    let author = manifest_value(text, "author");
    if (author != "") { print("author: " + author); }
    let description = manifest_value(text, "description");
    if (description != "") { print("description: " + description); }
    let dependencies = manifest_value(text, "dependencies");
    if (dependencies != "") { print("dependencies: " + dependencies); }
    let runtime = manifest_value(text, "runtime_" + platform() + "_" + arch());
    if (runtime != "") { print("runtime: " + runtime); }
    return 0;
}

func pack_package(output) {
    if (!file_exists("jau.pkg")) { print("JauPM: jau.pkg not found in current directory"); return 1; }
    let manifest = read_file("jau.pkg");
    let name = manifest_value(manifest, "name");
    let version = manifest_value(manifest, "version");
    let main = manifest_value(manifest, "main");
    if (name == "" || version == "" || main == "") { print("JauPM: jau.pkg requires name, version and main"); return 1; }
    if (!file_exists(main)) { print("JauPM: package main does not exist: " + main); return 1; }

    let runtime = manifest_value(manifest, "runtime_" + platform() + "_" + arch());
    if (runtime != "" && !file_exists(runtime)) {
        print("JauPM: declared native runtime does not exist: " + runtime);
        return 1;
    }

    mkdir("dist");
    if (output == "") { output = path_join("dist", name + "-" + version + ".jaup"); }
    print("Packing protected package " + name + "@" + version + "...");
    let result = jaup_pack(cwd(), output);
    if (!jaup_verify(output)) { print("JauPM: package self-verification failed"); return 1; }
    print("Built " + result + " -> " + output);
    print("Size: " + str(file_size(output)) + " bytes");
    print("Format: JAUPKG2 protected payload");
    if (runtime != "") { print("Native runtime: " + runtime); }
    return 0;
}

func installed_archive(name) { return package_archive(name); }

func stage_native_runtime(stored, dir, manifest, name, version) {
    let member = manifest_value(manifest, "runtime_" + platform() + "_" + arch());
    if (member == "") { return ""; }

    let staging = path_join(temp_dir(), "jaupm-runtime-" + str(hash64(name + version + member + str(clock_ns()))));
    if (file_exists(staging)) { remove_tree(staging); }
    mkdir(staging);
    jaup_extract(stored, staging);

    let source = path_join(staging, member);
    if (!file_exists(source)) {
        remove_tree(staging);
        print("JauPM: runtime member missing from package: " + member);
        return "!error";
    }

    let output = "";
    if (platform() == "windows") { output = path_join(dir, "runtime.dll"); }
    else if (platform() == "linux") { output = path_join(dir, "runtime.so"); }
    else {
        remove_tree(staging);
        print("JauPM: native runtime staging is not supported on " + platform());
        return "!error";
    }

    write_file(output, read_file(source));
    remove_tree(staging);
    if (!file_exists(output) || file_size(output) <= 0) {
        print("JauPM: failed to stage native runtime");
        return "!error";
    }
    return output;
}

func install_archive(archive, origin) {
    ensure_root();
    if (!file_exists(archive)) { print("JauPM: package file not found: " + archive); return 1; }
    if (!jaup_verify(archive)) { print("JauPM: package verification failed"); return 1; }

    let manifest = jaup_manifest(archive);
    let name = manifest_value(manifest, "name");
    let version = manifest_value(manifest, "version");
    let main = manifest_value(manifest, "main");
    if (name == "" || version == "" || main == "") { print("JauPM: invalid package manifest"); return 1; }

    let dir = package_dir(name);
    if (file_exists(dir)) { remove_tree(dir); }
    mkdir(dir);
    let stored = path_join(dir, "package.jaup");
    write_file(stored, read_file(archive));
    if (!jaup_verify(stored)) {
        remove_tree(dir);
        print("JauPM: installed archive verification failed");
        return 1;
    }

    let runtime = stage_native_runtime(stored, dir, manifest, name, version);
    if (runtime == "!error") { remove_tree(dir); return 1; }

    let dependencies = manifest_value(manifest, "dependencies");
    if (dependencies != "") {
        let deps = split(dependencies, ",");
        let i = 0;
        while (i < len(deps)) {
            let dep = trim(deps[i]);
            if (dep != "" && !package_installed(dep)) {
                print("Installing dependency: " + dep);
                let rc = install_target(dep, "");
                if (rc != 0) { print("JauPM: dependency installation failed: " + dep); return 1; }
            }
            i = i + 1;
        }
    }

    write_file(
        path_join(dir, ".installed"),
        "name=\"" + name + "\"\n" +
        "version=\"" + version + "\"\n" +
        "main=\"" + main + "\"\n" +
        "source=\"" + origin + "\"\n" +
        "runtime=\"" + runtime + "\"\n"
    );

    print("Installed " + name + "@" + version);
    print("Protected archive: " + stored);
    if (runtime != "") { print("Native runtime: " + runtime); }
    return 0;
}

func cache_name(hint) {
    let name = hint;
    if (name == "") { name = "download"; }
    return str(hash64(name + str(clock_ns()))) + ".jaup";
}

func download_archive(url, hint) {
    ensure_root();
    let target = path_join(path_join(package_home(), "cache"), cache_name(hint));
    print("Downloading package: " + url);
    download(url, target);
    if (!file_exists(target)) { print("JauPM: download did not create a package file"); return ""; }
    if (!jaup_verify(target)) {
        remove_file(target);
        print("JauPM: downloaded data is not a valid .jaup package");
        return "";
    }
    print("Downloaded " + str(file_size(target)) + " bytes");
    return target;
}

func install_target(spec, url) {
    if (url != "") {
        let archive = download_archive(url, spec);
        if (archive == "") { return 1; }
        return install_archive(archive, url);
    }
    if (file_exists(spec)) { return install_archive(spec, spec); }
    if (contains(spec, "://")) {
        let archive = download_archive(spec, "remote");
        if (archive == "") { return 1; }
        return install_archive(archive, spec);
    }
    let remote = registry_url(spec);
    let archive = download_archive(remote, spec);
    if (archive == "") { return 1; }
    return install_archive(archive, remote);
}

func install_manifest(url) {
    let text = http_get(url);
    let name = manifest_value(text, "name");
    let source = manifest_value(text, "source");
    if (name == "" || source == "") { print("JauPM: manifest requires name and source"); return 1; }
    return install_target(name, source);
}

func remove_package(name) {
    let dir = package_dir(name);
    if (!file_exists(dir)) { print("JauPM: package is not installed: " + name); return 1; }
    remove_tree(dir);
    print("Removed " + name);
    return 0;
}

func list_packages() {
    ensure_root();
    let root = path_join(package_home(), "packages");
    let items = list_dir(root);
    let i = 0;
    if (len(items) == 0) { print("No packages installed"); return 0; }
    while (i < len(items)) {
        let archive = package_archive(items[i]);
        if (file_exists(archive)) {
            let text = jaup_manifest(archive);
            let suffix = " [protected]";
            if (package_has_runtime(items[i])) { suffix = " [protected+native]"; }
            print(items[i] + "@" + manifest_value(text, "version") + suffix);
        } else { print(items[i] + " [legacy]"); }
        i = i + 1;
    }
    return 0;
}

func init_package(name) {
    if (name == "") { print("JauPM: package name is required"); return 1; }
    if (file_exists("jau.pkg")) { print("JauPM: jau.pkg already exists"); return 1; }
    mkdir("src");
    mkdir("tests");
    let manifest =
        "name=\"" + name + "\"\n" +
        "version=\"0.1.0\"\n" +
        "main=\"src/main.jau\"\n" +
        "author=\"\"\n" +
        "description=\"A Jau package\"\n" +
        "dependencies=\"\"\n";
    write_file("jau.pkg", manifest);
    if (!file_exists("src/main.jau")) {
        write_file("src/main.jau", "namespace " + name + " {\n    func hello(who) { return \"hello \" + who + \" from " + name + "\"; }\n}\n");
    }
    if (!file_exists("tests/test.jau")) {
        write_file("tests/test.jau", "import \"../src/main.jau\"\nprint(" + name + ".hello[\"Jau\"]);\n");
    }
    print("Created package " + name);
    print("  jau.pkg");
    print("  src/main.jau");
    print("  tests/test.jau");
    return 0;
}

func info_target(target) {
    if (file_exists(target)) {
        show_manifest(jaup_manifest(target));
        print("protected: true");
        return 0;
    }
    let archive = installed_archive(target);
    if (!file_exists(archive)) { print("JauPM: package not found: " + target); return 1; }
    show_manifest(jaup_manifest(archive));
    print("archive: " + archive);
    print("protected: true");
    let runtime = package_runtime(target);
    if (runtime != "") { print("runtime-path: " + runtime); }
    return 0;
}

func verify_archive(path) {
    if (!file_exists(path)) { print("JauPM: file not found: " + path); return 1; }
    if (jaup_verify(path)) {
        print("Package OK: " + path);
        show_manifest(jaup_manifest(path));
        print("format: protected binary");
        return 0;
    }
    print("Package verification failed: " + path);
    return 1;
}

func where_package(name) {
    let archive = installed_archive(name);
    if (!file_exists(archive)) { print("JauPM: package is not installed: " + name); return 1; }
    let main = manifest_value(jaup_manifest(archive), "main");
    print(archive + "#" + main);
    return 0;
}

func doctor() {
    ensure_root();
    print("JauPM 0.7 doctor");
    print("platform: " + platform());
    print("arch: " + arch());
    print("JAU_HOME: " + package_home());
    print("registry: " + registry_base());
    print("packages: " + str(len(list_dir(path_join(package_home(), "packages")))));
    print("package format: JAUPKG2 protected payload");
    print("native VM bridge: DLL/SO runtime sidecar + ffi.jau");
    return 0;
}

if (argc() == 0) { usage(); }
else {
    let cmd = arg(0);
    if (cmd == "help" || cmd == "--help" || cmd == "-h") { usage(); }
    else if (cmd == "version" || cmd == "--version") { print("JauPM 0.7"); }
    else if (cmd == "init" || cmd == "new") {
        if (argc() < 2) { usage(); } else { init_package(arg(1)); }
    } else if (cmd == "pack") {
        let out = "";
        if (argc() >= 2) { out = arg(1); }
        pack_package(out);
    } else if (cmd == "install") {
        if (argc() < 2) { usage(); }
        else {
            let url = "";
            if (argc() >= 3) { url = arg(2); }
            install_target(arg(1), url);
        }
    } else if (cmd == "install-manifest") {
        if (argc() < 2) { usage(); } else { install_manifest(arg(1)); }
    } else if (cmd == "verify") {
        if (argc() < 2) { usage(); } else { verify_archive(arg(1)); }
    } else if (cmd == "info") {
        if (argc() < 2) { usage(); } else { info_target(arg(1)); }
    } else if (cmd == "unpack") {
        if (argc() < 3) { usage(); }
        else { mkdir(arg(2)); jaup_extract(arg(1), arg(2)); print("Extracted -> " + arg(2)); }
    } else if (cmd == "update" || cmd == "upgrade") {
        if (argc() < 2) { usage(); } else { install_target(arg(1), ""); }
    } else if (cmd == "remove" || cmd == "uninstall") {
        if (argc() < 2) { usage(); } else { remove_package(arg(1)); }
    } else if (cmd == "registry") { print(registry_base()); }
    else if (cmd == "config") {
        if (argc() < 3) { usage(); }
        else if (arg(1) == "get" && arg(2) == "registry") { print(registry_base()); }
        else if (arg(1) == "set" && arg(2) == "registry") {
            if (argc() < 4) { usage(); } else { config_set_registry(arg(3)); }
        } else { print("JauPM: unknown config key"); }
    } else if (cmd == "cache-clean") {
        let cache = path_join(package_home(), "cache");
        if (file_exists(cache)) { remove_tree(cache); }
        mkdir(cache);
        print("Cache cleaned: " + cache);
    } else if (cmd == "home") { print(package_home()); }
    else if (cmd == "list" || cmd == "ls") { list_packages(); }
    else if (cmd == "where") {
        if (argc() < 2) { usage(); } else { where_package(arg(1)); }
    } else if (cmd == "runtime") {
        if (argc() < 2) { usage(); }
        else {
            let runtime = package_runtime(arg(1));
            if (runtime == "") { print("JauPM: package has no runtime for this platform"); }
            else { print(runtime); }
        }
    } else if (cmd == "doctor" || cmd == "env") { doctor(); }
    else { print("JauPM: unknown command: " + cmd); usage(); }
}
