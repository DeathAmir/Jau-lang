import "pkg.jau"

func usage() {
    print("JauPM 0.4");
    print("  jaupm help");
    print("  jaupm version");
    print("  jaupm init NAME");
    print("  jaupm pack [OUTPUT.jaup]");
    print("  jaupm install NAME|FILE.jaup|URL [URL]");
    print("  jaupm install-manifest URL");
    print("  jaupm verify FILE.jaup");
    print("  jaupm info NAME|FILE.jaup");
    print("  jaupm unpack FILE.jaup DIR");
    print("  jaupm update NAME");
    print("  jaupm remove NAME");
    print("  jaupm list");
    print("  jaupm where NAME");
    print("  jaupm cache-clean");
    print("  jaupm home");
    print("  jaupm doctor");
    return 0;
}

func ensure_root() {
    let h = package_home();
    mkdir(h);
    mkdir(path_join(h, "packages"));
    mkdir(path_join(h, "cache"));
    return h;
}

func registry_base() {
    return getenv("JAU_REGISTRY");
}

func registry_url(name) {
    let r = registry_base();
    if (r == "") { return ""; }
    return r + "/" + name + "/latest.jaup";
}

func show_manifest(text) {
    print("name: " + manifest_value(text, "name"));
    print("version: " + manifest_value(text, "version"));
    print("main: " + manifest_value(text, "main"));
    let author = manifest_value(text, "author");
    if (author != "") { print("author: " + author); }
    let description = manifest_value(text, "description");
    if (description != "") { print("description: " + description); }
    return 0;
}

func pack_package(output) {
    if (!file_exists("jau.pkg")) {
        print("JauPM: jau.pkg not found in current directory");
        return 1;
    }
    let manifest = read_file("jau.pkg");
    let name = manifest_value(manifest, "name");
    let version = manifest_value(manifest, "version");
    let main = manifest_value(manifest, "main");
    if (name == "" || version == "" || main == "") {
        print("JauPM: jau.pkg requires name, version and main");
        return 1;
    }
    if (!file_exists(main)) {
        print("JauPM: package main does not exist: " + main);
        return 1;
    }
    mkdir("dist");
    if (output == "") { output = path_join("dist", name + "-" + version + ".jaup"); }
    print("Packing " + name + "@" + version + "...");
    let result = jaup_pack(cwd(), output);
    print("Built " + result + " -> " + output);
    print("Size: " + str(file_size(output)) + " bytes");
    return 0;
}

func install_archive(archive, source) {
    ensure_root();
    if (!file_exists(archive)) {
        print("JauPM: package file not found: " + archive);
        return 1;
    }
    if (!jaup_verify(archive)) {
        print("JauPM: package verification failed");
        return 1;
    }
    let manifest = jaup_manifest(archive);
    let name = manifest_value(manifest, "name");
    let version = manifest_value(manifest, "version");
    let main = manifest_value(manifest, "main");
    if (name == "" || version == "" || main == "") {
        print("JauPM: invalid package manifest");
        return 1;
    }
    let dir = package_dir(name);
    if (file_exists(dir)) { remove_tree(dir); }
    mkdir(dir);
    jaup_extract(archive, dir);
    if (!file_exists(path_join(dir, main))) {
        print("JauPM: extracted package is missing main: " + main);
        remove_tree(dir);
        return 1;
    }
    if (main != "main.jau") { write_file(path_join(dir, "main.jau"), read_file(path_join(dir, main))); }
    write_file(path_join(dir, ".installed"), "name=\"" + name + "\"\nversion=\"" + version + "\"\nsource=\"" + source + "\"\n");
    print("Installed " + name + "@" + version);
    print("Location: " + dir);
    return 0;
}

func download_archive(url, hint) {
    ensure_root();
    let name = hint;
    if (name == "") { name = "download"; }
    let target = path_join(path_join(package_home(), "cache"), name + ".jaup");
    print("Downloading " + url);
    download(url, target);
    return target;
}

func install_source(name, url) {
    ensure_root();
    let dir = package_dir(name);
    if (file_exists(dir)) { remove_tree(dir); }
    mkdir(dir);
    let out = path_join(dir, "main.jau");
    print("Downloading source package " + name + " from " + url);
    download(url, out);
    write_file(path_join(dir, "jau.pkg"), "name=\"" + name + "\"\nversion=\"0.0.0-source\"\nmain=\"main.jau\"\nsource=\"" + url + "\"\n");
    write_file(path_join(dir, ".installed"), "source=\"" + url + "\"\nhash=\"" + str(hash64(read_file(out))) + "\"\n");
    print("Installed source package " + name + " -> " + out);
    return 0;
}

func install_target(spec, url) {
    if (url != "") {
        if (contains(url, ".jaup")) {
            let archive = download_archive(url, spec);
            return install_archive(archive, url);
        }
        return install_source(spec, url);
    }
    if (file_exists(spec)) {
        return install_archive(spec, spec);
    }
    if (contains(spec, "://")) {
        let archive = download_archive(spec, "remote");
        return install_archive(archive, spec);
    }
    let remote = registry_url(spec);
    if (remote == "") {
        print("JauPM: package is not a local file and JAU_REGISTRY is empty");
        return 1;
    }
    let archive = download_archive(remote, spec);
    return install_archive(archive, remote);
}

func install_manifest(url) {
    let text = http_get(url);
    let name = manifest_value(text, "name");
    let source = manifest_value(text, "source");
    if (name == "" || source == "") {
        print("JauPM: manifest requires name and source");
        return 1;
    }
    return install_target(name, source);
}

func remove_package(name) {
    let dir = package_dir(name);
    if (!file_exists(dir)) {
        print("JauPM: package is not installed: " + name);
        return 1;
    }
    remove_tree(dir);
    print("Removed " + name);
    return 0;
}

func list_packages() {
    ensure_root();
    let root = path_join(package_home(), "packages");
    let items = list_dir(root);
    let i = 0;
    if (len(items) == 0) { print("No packages installed"); return 0; }
    while (i < len(items)) {
        let dir = path_join(root, items[i]);
        let mf = path_join(dir, "jau.pkg");
        if (file_exists(mf)) {
            let text = read_file(mf);
            print(items[i] + "@" + manifest_value(text, "version"));
        } else { print(items[i]); }
        i = i + 1;
    }
    return 0;
}

func init_package(name) {
    if (name == "") { print("JauPM: package name is required"); return 1; }
    if (file_exists("jau.pkg")) { print("JauPM: jau.pkg already exists"); return 1; }
    mkdir("src");
    mkdir("tests");
    let manifest = "name=\"" + name + "\"\nversion=\"0.1.0\"\nmain=\"src/main.jau\"\nauthor=\"\"\ndescription=\"A Jau package\"\n";
    write_file("jau.pkg", manifest);
    if (!file_exists("src/main.jau")) {
        write_file("src/main.jau", "func hello(name) { return \"hello \" + name + \" from " + name + "\"; }\n");
    }
    if (!file_exists("tests/test.jau")) {
        write_file("tests/test.jau", "import \"../src/main.jau\"\nprint(hello(\"Jau\"));\n");
    }
    print("Created package " + name);
    print("  jau.pkg");
    print("  src/main.jau");
    print("  tests/test.jau");
    return 0;
}

func info_target(target) {
    if (file_exists(target)) {
        show_manifest(jaup_manifest(target));
        return 0;
    }
    let mf = path_join(package_dir(target), "jau.pkg");
    if (!file_exists(mf)) { print("JauPM: package not found: " + target); return 1; }
    show_manifest(read_file(mf));
    print("path: " + package_dir(target));
    return 0;
}

func verify_archive(path) {
    if (!file_exists(path)) { print("JauPM: file not found: " + path); return 1; }
    if (jaup_verify(path)) {
        print("Package OK: " + path);
        show_manifest(jaup_manifest(path));
        return 0;
    }
    print("Package verification failed: " + path);
    return 1;
}

func doctor() {
    ensure_root();
    print("JauPM 0.4 doctor");
    print("platform: " + platform());
    print("arch: " + arch());
    print("JAU_HOME: " + package_home());
    let r = registry_base();
    if (r == "") { print("JAU_REGISTRY: not configured"); }
    else { print("JAU_REGISTRY: " + r); }
    print("packages: " + str(len(list_dir(path_join(package_home(), "packages")))));
    return 0;
}

if (argc() == 0) { usage(); }
else {
    let cmd = arg(0);
    if (cmd == "help" || cmd == "--help" || cmd == "-h") { usage(); }
    else if (cmd == "version" || cmd == "--version") { print("JauPM 0.4"); }
    else if (cmd == "init" || cmd == "new") {
        if (argc() < 2) { usage(); } else { init_package(arg(1)); }
    } else if (cmd == "pack") {
        let out = ""; if (argc() >= 2) { out = arg(1); } pack_package(out);
    } else if (cmd == "install") {
        if (argc() < 2) { usage(); }
        else { let url = ""; if (argc() >= 3) { url = arg(2); } install_target(arg(1), url); }
    } else if (cmd == "install-manifest") {
        if (argc() < 2) { usage(); } else { install_manifest(arg(1)); }
    } else if (cmd == "verify") {
        if (argc() < 2) { usage(); } else { verify_archive(arg(1)); }
    } else if (cmd == "info") {
        if (argc() < 2) { usage(); } else { info_target(arg(1)); }
    } else if (cmd == "unpack") {
        if (argc() < 3) { usage(); }
        else { mkdir(arg(2)); jaup_extract(arg(1), arg(2)); print("Extracted -> " + arg(2)); }
    } else if (cmd == "update" || cmd == "upgrade") {
        if (argc() < 2) { usage(); } else { install_target(arg(1), ""); }
    } else if (cmd == "remove" || cmd == "uninstall") {
        if (argc() < 2) { usage(); } else { remove_package(arg(1)); }
    } else if (cmd == "cache-clean") {
        let cache = path_join(package_home(), "cache");
        if (file_exists(cache)) { remove_tree(cache); }
        mkdir(cache);
        print("Cache cleaned: " + cache);
    } else if (cmd == "home") { print(package_home()); }
    else if (cmd == "list" || cmd == "ls") { list_packages(); }
    else if (cmd == "where") {
        if (argc() < 2) { usage(); } else { print(package_main(arg(1))); }
    } else if (cmd == "doctor" || cmd == "env") { doctor(); }
    else { print("JauPM: unknown command: " + cmd); usage(); }
}
