        case Op::Add:{auto b=pop(),a=pop();stack.push_back(addv(a,b));break;}case Op::Sub:{auto b=pop(),a=pop();stack.push_back(subv(a,b));break;}case Op::Mul:{auto b=pop(),a=pop();stack.push_back(mulv(a,b));break;}case Op::Div:{auto b=pop(),a=pop();double d=as_double(b);if(d==0)throw Error("division by zero");stack.push_back(as_double(a)/d);break;}case Op::Mod:{auto b=pop(),a=pop();auto d=as_int(b);if(!d)throw Error("division by zero");stack.push_back(as_int(a)%d);break;}case Op::Neg:{auto a=pop();stack.push_back(std::holds_alternative<int64_t>(a.data)?Value(-std::get<int64_t>(a.data)):Value(-as_double(a)));break;}case Op::Not:{auto a=pop();stack.push_back(!a.truthy());break;}
        case Op::Eq:{auto b=pop(),a=pop();stack.push_back(eq(a,b));break;}case Op::Ne:{auto b=pop(),a=pop();stack.push_back(!eq(a,b));break;}case Op::Lt:{auto b=pop(),a=pop();stack.push_back(as_double(a)<as_double(b));break;}case Op::Le:{auto b=pop(),a=pop();stack.push_back(as_double(a)<=as_double(b));break;}case Op::Gt:{auto b=pop(),a=pop();stack.push_back(as_double(a)>as_double(b));break;}case Op::Ge:{auto b=pop(),a=pop();stack.push_back(as_double(a)>=as_double(b));break;}case Op::And:{auto b=pop(),a=pop();stack.push_back(a.truthy()&&b.truthy());break;}case Op::Or:{auto b=pop(),a=pop();stack.push_back(a.truthy()||b.truthy());break;}
        case Op::Jump:fr.ip=in.a;break;case Op::JumpFalse:if(!stack.back().truthy())fr.ip=in.a;break;
        case Op::Call:{if(in.a<0){stack.push_back(builtin(in.a));break;}auto&callee=p.funcs.at(in.a);if(stack.size()<(size_t)callee.arity)throw Error("not enough arguments");std::vector<Value> loc(std::max(callee.locals,callee.arity));for(int q=callee.arity-1;q>=0;--q)loc[q]=pop();frames.push_back({in.a,0,std::move(loc)});break;}
        case Op::Ret:{Value rv=pop();frames.pop_back();if(frames.empty())return rv;stack.push_back(std::move(rv));break;}case Op::Halt:return Value();
