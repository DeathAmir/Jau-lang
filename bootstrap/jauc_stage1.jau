// Stage-1 bootstrap compiler, implemented in Jau.
// It compiles a deliberately auditable bootstrap subset to freestanding
// Linux Intel assembly which Jau's own jauas turns into ELF without GCC/ld/as.
// Stage-1 currently supports integer/string literal print calls and return.
let stage_data = "";
let stage_label = 0;
let stage_target = "linux-x86_64";

func emit_prelude() {
    return ".intel_syntax noprefix\n.text\n.globl _start\n_start:\n";
}

func asm_escape(text) {
    let out = replace(text, "\\", "\\\\");
    out = replace(out, "\"", "\\\"");
    return out;
}

func emit_text(text) {
    let label = "msg" + str(stage_label);
    stage_data = stage_data + label + ": .ascii \"" + asm_escape(text) + "\\n\"\n";
    stage_label = stage_label + 1;
    let size = len(text) + 1;
    if (stage_target == "linux-x86") {
        return "  mov eax, 4\n  mov ebx, 1\n  mov ecx, " + label + "\n  mov edx, " + str(size) + "\n  int 0x80\n";
    }
    return "  mov rax, 1\n  mov rdi, 1\n  lea rsi, [rip+" + label + "]\n  mov rdx, " + str(size) + "\n  syscall\n";
}

func emit_print(raw) {
    let value = trim(raw);
    if (len(value) >= 2 && char_at(value, 0) == "\"" && char_at(value, len(value) - 1) == "\"") {
        return emit_text(substr(value, 1, len(value) - 2));
    }
    return emit_text(str(int(value)));
}

func compile_prints(src) {
    let out = "";
    let rest = src;
    while (true) {
        let p = find(rest, "print(");
        if (p < 0) { break; }
        rest = substr(rest, p + 6, len(rest) - p - 6);
        let e = find(rest, ")");
        if (e < 0) { break; }
        out = out + emit_print(substr(rest, 0, e));
        rest = substr(rest, e + 1, len(rest) - e - 1);
    }
    return out;
}

func compile_return(src) {
    let p = find(src, "return ");
    let value = 0;
    if (p >= 0) {
        let rest = substr(src, p + 7, len(src) - p - 7);
        let e = find(rest, ";");
        if (e < 0) { e = len(rest); }
        value = int(trim(substr(rest, 0, e)));
    }
    if (stage_target == "linux-x86") { return "  mov eax, 1\n  mov ebx, " + str(value) + "\n  int 0x80\n"; }
    return "  mov rax, 60\n  mov rdi, " + str(value) + "\n  syscall\n";
}

func compile_file_stage1(input, output, target) {
    stage_data = "";
    stage_label = 0;
    stage_target = target;
    let src = read_file(input);
    let asm = emit_prelude() + compile_prints(src) + compile_return(src) + ".section .rodata\n" + stage_data;
    write_file(output, asm);
    print("stage1 compiled " + input + " -> " + output + " [" + target + "]");
    return 0;
}

if (argc() >= 2) {
    let target = "linux-x86_64";
    if (argc() >= 3) { target = arg(2); }
    compile_file_stage1(arg(0), arg(1), target);
}
