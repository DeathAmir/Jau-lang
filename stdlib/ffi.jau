/*
    Jau FFI Standard Library

    Cross-platform dynamic library helpers for the Jau VM. Handles and function
    pointers are represented as integer-sized opaque values. ffi.cstr() pins a
    UTF-8 string for native calls until ffi.release() is called.
*/

namespace ffi {
    func open(path) { return dll_open(path); }
    func symbol(module, name) { return dll_symbol(module, name); }
    func close(module) { return dll_close(module); }

    func call0(pointer) { return dll_call0(pointer); }
    func call1(pointer, a) { return dll_call1(pointer, a); }
    func call2(pointer, a, b) { return dll_call2(pointer, a, b); }
    func call3(pointer, a, b, c) { return dll_call3(pointer, a, b, c); }
    func call4(pointer, a, b, c, d) { return dll_call4(pointer, a, b, c, d); }

    func cstr(text) { return ffi_cstr(text); }
    func release(pointer) { return ffi_release(pointer); }
    func error() { return dll_error(); }
}
